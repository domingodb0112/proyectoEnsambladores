; Prueba de elementos compuestos (indivisibles)
; Cada linea valida debe mostrar el compuesto como UN solo elemento.

.data segment
.data   segment                 ; varios espacios entre las palabras
.stack	segment                 ; tabulador entre las palabras
.CODE Segment                   ; mayusculas y minusculas
    tabla    dw  10 dup(?)
    tabla2   dw  10 dup (0)     ; espacio antes del parentesis
    matriz   db  3 dup(2 dup(0))
    texto    db  "a;b, c:d", 0  ; ; , : dentro de comillas NO separan ni comentan
    letra    db  'A'
    mal1     db  "sin cerrar     ; comilla sin cerrar

    mov ax, word ptr [bx]
    mov al, byte  ptr [di+2]    ; dos espacios dentro de byte ptr
    mov al, byte ptr[si]        ; sin espacio antes del corchete
    mov ax, word	ptr [bx+si+4]
    lea dx, [msg + si]          ; espacios dentro de los corchetes
    JNP   salir                 ; instruccion soportada
    xchg  ax, bx                ; instruccion soportada

    mov ax, [bx+]               ; invalido: operando vacio
    mov ax, []                  ; invalido: vacio
    mov ax, [zz!]               ; invalido: caracter extrano
    mov ax, [bx                 ; invalido: falta cerrar corchete
    dw 5 dup(!!)                ; invalido: contenido de dup
    dw 5 dup(0                  ; invalido: falta cerrar parentesis
salir:
    end
