; ==========================================================
; UAEMex - Ensambladores (2026B)
; Programa de demostracion (Fase 1)
; ==========================================================

.data segment
    mensaje     db  "Hola Mundo desde Ensamblador 8086", 0
    buffer      dw  20 dup(?)
    cuenta      db  50d
    mascara_hex dw  0FFh
    patron_bin  db  10110011b
    err_hex     dw  FFh         ; Constante mal formada (falta 0)
    err_bin     db  102b        ; Constante mal formada (digito 2)
.code segment
    assume cs:code, ds:data
inicio:
    CLD                         ; Instruccion soportada (01)
    CLI                         ; Instruccion soportada (02)
    NOP                         ; Instruccion soportada (03)
    POPA                        ; Instruccion soportada (04)
    AAD                         ; Instruccion soportada (05)
    AAM                         ; Instruccion soportada (06)
    
    MOV AX, BX                  ; MOV: instruccion no soportada
    ADD CX, DX                  ; ADD: instruccion no soportada
    
    INC AX                      ; Instruccion soportada (08)
    MUL BL                      ; Instruccion soportada (07)
    IDIV CL                     ; Instruccion soportada (09)
    SAR DX, 1                   ; Instruccion soportada (10)
    TEST AX, 000Fh              ; Instruccion soportada (11)
    RCL BX, 1                   ; Instruccion soportada (12)
    XCHG SI, DI                 ; Instruccion soportada (13)
    
    JB menor                    ; Instruccion soportada (14)
    JE igual                    ; Instruccion soportada (15)
    JNLE mayor                  ; Instruccion soportada (16)
    JP paridad                  ; Instruccion soportada (17)
    JCXZ salir                  ; Instruccion soportada (18)
    JZ fin                      ; Instruccion soportada (19)

menor:
    mov word ptr [bx], 1
igual:
    mov byte ptr [di+2], 0
mayor:
    nop
paridad:
    nop
salir:
fin:
    end inicio
